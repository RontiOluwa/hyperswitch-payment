cat > .gitignore << 'EOF'
# Dependencies
node_modules/
.pnp
data.md
.pnp.js

# Build outputs
dist/
build/
.next/

# Environment files — NEVER commit these
.env
.env.local
.env.*.local
.env.production

# Logs
logs/
*.log
npm-debug.log*

# Docker volumes
.docker/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Turbo
.turbo/

# Test coverage
coverage/
EOF