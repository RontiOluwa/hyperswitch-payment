FROM node:20-alpine

RUN apk add --no-cache python3 make g++

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY tsconfig.json ./
COPY medusa-config.ts ./

# Compile the config file first so Medusa can find it
RUN npx tsc medusa-config.ts --outDir . --module commonjs --esModuleInterop true --skipLibCheck true

COPY src ./src

RUN npm run build

EXPOSE 9000
EXPOSE 9001

CMD ["npm", "run", "start"]