{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "medusa-config.ts",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    ".medusa"
  ]
}
